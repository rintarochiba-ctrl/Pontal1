erDiagram
    employee ||--o{ salary_slip : "has"
    employee ||--o{ audit_log : "acts as (actor)"
    employee ||--o{ audit_log : "is target of"

    employee {
        bigint id PK
        varchar name
        varchar email UK
        varchar cognito_sub UK
        varchar department
        varchar position
        date join_date
        varchar gender
        smallint age
        varchar birthplace
        boolean is_system_admin
        boolean is_hr_admin
        varchar image_url
        text bio
        varchar hobby
        text self_qa
        boolean is_delete
        timestamp created_at
        timestamp updated_at
    }

    salary_slip {
        bigint id PK
        bigint employee_id FK
        varchar pay_month
        varchar file_path
        bigint uploaded_by FK
        timestamp uploaded_at
    }

    audit_log {
        bigint id PK
        bigint actor_employee_id FK
        bigint target_employee_id FK
        varchar resource_type
        bigint resource_id
        varchar action
        timestamp occurred_at
    }

    audit_log_export_batch {
        bigint id PK
        date period_start
        date period_end
        varchar status
        int record_count
        varchar file_path
        timestamp created_at
        timestamp completed_at
    }
